# Copia este archivo como .env y ajusta los valores.

# Base de datos PostgreSQL (Neon recomendado).
# DATABASE_URL: conexión "pooled" (PgBouncer) que usa la app.
# DIRECT_URL: conexión directa, usada por Prisma para migraciones (db push).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# URL pública del sitio (metadatos SEO / Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Medición y verificación (todo opcional) ----
# Los scripts de GA4 y Meta Pixel SOLO se cargan tras aceptar el banner de
# cookies. Si dejas estas variables vacías, no se muestra el banner ni se carga
# ningún script de terceros.
# Google Analytics 4 — ID de medición (formato G-XXXXXXX).
NEXT_PUBLIC_GA_ID=""
# Meta Pixel — ID numérico del píxel (retargeting / catálogo de Instagram).
NEXT_PUBLIC_META_PIXEL_ID=""
# Google Search Console — token de verificación por meta etiqueta
# (Search Console → Añadir propiedad → Etiqueta HTML → copia solo el "content").
NEXT_PUBLIC_GSC_VERIFICATION=""
# Verificación de dominio de Meta (Business Settings → Brand safety → Domains →
# copia solo el valor de "content" de la meta facebook-domain-verification).
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=""
# WhatsApp para el botón flotante de dudas (formato internacional sin "+" ni
# espacios, p. ej. 34600112233). Vacío = no se muestra el botón.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Contraseña para acceder al panel de administración en /admin.
# ¡Cámbiala por una segura antes de desplegar!
ADMIN_PASSWORD="cambia-esta-contrasena"

# Secreto para firmar las sesiones de usuario (una cadena larga y aleatoria).
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Stripe (opcional). Si NO se configuran, el checkout usa pago simulado.
# Clave secreta de tu cuenta Stripe (modo test: empieza por sk_test_...).
STRIPE_SECRET_KEY=""
# Secreto de firma del webhook (whsec_...), de Stripe → Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=""

# Email — opción A (GRATIS, sin dominio): SMTP de Gmail con "contraseña de aplicación".
# Envía a CUALQUIER destinatario. Crea la contraseña en myaccount.google.com (2FA + App passwords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="" # contraseña de aplicación de 16 caracteres (sin espacios)

# Email — opción B (Resend). Para enviar a cualquier correo necesita dominio verificado.
RESEND_API_KEY=""

# Remitente de los correos. Con Gmail, debe ser tu propia dirección de Gmail.
EMAIL_FROM="Ocean Blvd Vinyl <tucorreo@gmail.com>"

# Acceso con Google (OAuth 2.0). Crea las credenciales en Google Cloud Console.
# Redirect URI autorizado: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
