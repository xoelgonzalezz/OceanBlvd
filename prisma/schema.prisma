// Ocean Blvd Vinyl — esquema de base de datos
// SQLite en desarrollo. Para migrar a PostgreSQL: cambia `provider` a "postgresql"
// y `DATABASE_URL` (los modelos son compatibles, no usamos tipos exclusivos de SQLite).

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; "rhel-openssl-3.0.x" para el runtime de Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" (PgBouncer) para la app; conexión directa para migraciones.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Género musical (Rock, Jazz, Hip-Hop...)
model Genre {
  id            String   @id @default(cuid())
  name          String   @unique
  slug          String   @unique
  description   String?
  descriptionEn String?
  // Pequeño icono/emoji para la rejilla de géneros del home.
  emoji         String?
  records       Record[]

  @@index([slug])
}

/// Artista o banda.
model Artist {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  bio         String
  bioEn       String?
  image       String?
  country     String?
  foundedYear Int?
  featured    Boolean  @default(false)
  // Archivado: se "borra" de la tienda sin perder historial cuando tiene ventas.
  archived    Boolean  @default(false)
  records     Record[]
  createdAt   DateTime @default(now())

  @@index([slug])
}

/// Un disco de vinilo (producto principal de la tienda).
model Record {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  label         String // sello discográfico
  year          Int
  decade        Int // 1970, 1980... (precalculado para filtrar)
  priceCents    Int // precio en céntimos para evitar errores de coma flotante
  condition     String   @default("USED") // "NEW" (nuevo) | "USED" (segunda mano)
  mediaGrade    String? // "M" | "NM" | "VG+" | "VG" ... (estado del disco)
  description   String
  descriptionEn String?
  stock         Int      @default(1)
  salesCount    Int      @default(0) // para "Más vendidos" / popularidad
  featured      Boolean  @default(false) // destacados del home/hero
  // Archivado: "borrado" de la tienda. Si el disco ya tiene pedidos no se
  // elimina (rompería el historial); se archiva y deja de mostrarse.
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now()) // para "Últimas novedades"

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genreId  String
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  images     RecordImage[]
  tracks     Track[]
  orderItems OrderItem[]
  reviews    Review[]

  @@index([slug])
  @@index([artistId])
  @@index([genreId])
  @@index([decade])
  @@index([createdAt])
  @@index([salesCount])
}

/// Imágenes de un disco (portada=0, contraportada=1, ...).
model RecordImage {
  id       String @id @default(cuid())
  url      String
  alt      String
  position Int    @default(0)

  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

/// Pista del tracklist de un disco.
model Track {
  id       String  @id @default(cuid())
  position Int
  title    String
  duration String? // "3:45"

  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

/// Artículo del blog / noticias.
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  excerptEn   String?
  content     String // cuerpo del artículo (texto enriquecido / párrafos)
  contentEn   String?
  coverImage  String?
  author      String
  tag         String? // "Lanzamientos" | "Cultura" | "Ediciones especiales"...
  publishedAt DateTime @default(now())

  @@index([slug])
  @@index([publishedAt])
}

/// Cuenta de cliente.
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String? // opcional: las cuentas de Google no tienen contraseña
  image             String? // avatar (p. ej. de Google)
  provider          String? // "google" si se registró con Google
  verified          Boolean   @default(false) // email verificado con código
  verifyCode        String? // código de verificación (OTP de 6 dígitos)
  verifyCodeExpires DateTime?
  createdAt         DateTime  @default(now())
  orders            Order[]
  reviews           Review[]

  @@index([email])
}

/// Reseña/valoración de un disco por un usuario.
model Review {
  id        String   @id @default(cuid())
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([userId, recordId]) // una reseña por usuario y disco
  @@index([recordId])
}

/// Pedido (la pasarela de pago es simulada por ahora).
model Order {
  id             String      @id @default(cuid())
  email          String
  fullName       String
  address        String
  city           String
  postalCode     String
  country        String      @default("España")
  phone          String?
  notes          String?
  subtotalCents  Int
  shippingCents  Int
  totalCents     Int
  status         String      @default("PENDING") // PENDING | PAID | SHIPPED | CANCELLED
  // Envío: número de seguimiento (localizador) de Correos y fecha de salida.
  carrier        String?     @default("Correos")
  trackingNumber String?
  shippedAt      DateTime?
  // Token aleatorio para acceder a la confirmación sin sesión (evita IDOR por id).
  accessToken    String?     @default(cuid())
  createdAt      DateTime    @default(now())
  items          OrderItem[]

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Línea de un pedido.
model OrderItem {
  id             String @id @default(cuid())
  quantity       Int    @default(1)
  unitPriceCents Int // precio en el momento de la compra

  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordId String
  record   Record @relation(fields: [recordId], references: [id])

  @@index([orderId])
  @@index([recordId])
}

/// Suscriptor de la newsletter (footer).
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Mensaje del formulario de contacto.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}
